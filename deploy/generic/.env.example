# deploy/generic/.env にコピーして埋める / copy to deploy/generic/.env and fill in.
# このファイルは Git に入れないこと / never commit the filled-in copy.

# 公開ドメイン。Let's Encrypt の証明書はこの名前で取得される。
# ドメインを持っていない場合は DuckDNS などの無料サブドメインで足りる。
# A certificate needs a name; a free subdomain from DuckDNS is enough if you
# do not have one.
DOMAIN=pmo.example.com

# Web 画面のアクセスキー / access keys for the web interface.
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
#
# 実行できる人に渡す / for people who may run things
AIPMO_WEB_TOKEN=
# 見るだけの人に渡す。必ず上と別の値にすること。
# For people who may only look. Must differ from the one above.
AIPMO_VIEWER_TOKEN=

# PostgreSQL の接続文字列。3通りの構成のどれかになります:
#
#   1. Aiven など外部の無料プラン（sslmode=verify-full を必ず付ける）
#      postgresql://user:PASSWORD@host.aivencloud.com:PORT/defaultdb?sslmode=verify-full&sslrootcert=/app/db-ca.pem
#   2. クラウド提供元のマネージド DB（例: AWS RDS）
#      postgresql://user:PASSWORD@xxxx.rds.amazonaws.com:5432/aipmo?sslmode=verify-full&sslrootcert=/app/db-ca.pem
#   3. 同じ compose 内の自前 Postgres（--profile selfhosted で起動した場合）
#      postgresql://aipmo:aipmo@postgres:5432/aipmo
#
# The connection string takes one of three shapes: an external free plan
# (Aiven), a cloud provider's managed DB (e.g. AWS RDS), or your own
# Postgres in this same compose file (started with --profile selfhosted).
# Keep sslmode=verify-full for options 1 and 2 — sslmode=require alone
# encrypts but does not verify the certificate.
AIPMO_PG_DSN=

OPENAI_API_KEY=
