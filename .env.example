# deploy/oracle/.env にコピーして埋める / copy to deploy/oracle/.env and fill in.
# このファイルは Git に入れないこと / never commit the filled-in copy.

# 公開ドメイン。Let's Encrypt の証明書はこの名前で取得される。
# ドメインを持っていない場合は DuckDNS などの無料サブドメインで足りる。
DOMAIN=pmo.example.com

# Web 画面のアクセスキー / access key for the web interface.
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
AIPMO_WEB_TOKEN=

# Aiven の接続文字列。コンソールからコピーする。
# 末尾の sslmode=verify-full と sslrootcert は必ず付けること。
# Copy from the Aiven console. Keep sslmode=verify-full and sslrootcert:
# without them the connection can be silently downgraded.
AIPMO_PG_DSN=postgresql://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=verify-full&sslrootcert=/app/aiven-ca.pem

OPENAI_API_KEY=
