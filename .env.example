# .env にコピーして埋める / copy to .env and fill in.
# ./scripts/install-docker.sh を使えば、対話的に答えるだけでこのファイルを
# 自動生成する——手で書く必要はない。手で編集したい場合の参考として
# 残してある。
#
# ./scripts/install-docker.sh writes this file for you from your interactive
# answers — you do not need to write it by hand. Kept here as a reference
# for editing it directly.

# PostgreSQL のパスワード（自前で立てる場合のみ意味を持つ）。
# PostgreSQL's password (only matters when self-hosting it).
POSTGRES_PASSWORD=aipmo

# PostgreSQL の接続先。自前で立てる場合はこのコンテナ名のままでよい。
# 外部に接続する場合は、その接続文字列に書き換える。
# PostgreSQL's target. Leave as this container's name when self-hosting;
# switch to an external connection string otherwise.
AIPMO_PG_DSN=postgresql://aipmo:aipmo@postgres:5432/aipmo

# Ollama の接続先。自前で立てる場合はこのコンテナ名のままでよい。
# 外部に接続する場合は、その URL に書き換える。
# Ollama's target. Leave as this container's name when self-hosting;
# switch to an external URL otherwise.
OLLAMA_HOST=http://ollama:11434

# Qdrant（ナレッジ機能）。任意 — 両方空のままなら機能ごと使わない。
# 自前で立てる場合は QDRANT_URL だけこのコンテナ名にする（API key は
# 不要）。外部の Qdrant Cloud などに接続する場合は、その URL と
# API key に書き換える。
#
# Qdrant (the knowledge features). Optional — leave both empty to skip it
# entirely. Self-hosting needs only QDRANT_URL set to this container's
# name (no API key). An external Qdrant Cloud instance needs its own URL
# and API key here instead.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# WebUI（--profile web のときだけ使われる）。任意 — 空のままなら
# 起動のたびに新しいトークンが発行される。固定したい場合はそれぞれ
# 別の値を書く（docs/MOBILE.md 参照）。
#
# The WebUI (only used with --profile web). Optional — leave empty and a
# new token is minted on every start. To pin them, set two different
# values (see docs/MOBILE.md).
AIPMO_WEB_TOKEN=
AIPMO_VIEWER_TOKEN=
AIPMO_CORS_ORIGINS=
